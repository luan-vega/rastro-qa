{
  "name": "rastro-qa",
  "version": "0.1.0",
  "description": "Validação de backend ponta a ponta: tela, API, logs, performance e evidências em PDF, com IA gerando as queries.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "rastro": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx scripts/demo.ts",
    "test:e2e": "vitest run tests/mcp.e2e.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1169.0",
    "@aws-sdk/credential-providers": "^3.1169.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.3",
    "csv-parse": "^5.6.0",
    "playwright": "^1.63.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@usebruno/cli": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
